        "@hrx_system//runtime/src/iree/base",
        "@hrx_system//runtime/src/iree/base/internal",
        "@hrx_system//runtime/src/iree/base/tooling:flags",
        "@hrx_system//runtime/src/iree/hal",
        "@hrx_system//runtime/src/iree/hal/utils:statistics_sink",
        "@hrx_system//runtime/src/iree/io:file_handle",
        "@hrx_system//runtime/src/iree/io:parameter_provider",
        "@hrx_system//runtime/src/iree/tokenizer",
