module(
    name = "hrx_demos",
    version = "0.0.0",
    bazel_compatibility = [">=9.1.0"],
)

bazel_dep(
    name = "iree",
    version = "0.0.0",
    repo_name = "hrx_system",
)
local_path_override(
    module_name = "iree",
    path = "third_party/hrx-system",
)

bazel_dep(name = "rules_python", version = "2.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(
    name = "googletest",
    version = "1.17.0.bcr.2",
    repo_name = "com_google_googletest",
)
bazel_dep(
    name = "google_benchmark",
    version = "1.9.5",
    repo_name = "com_google_benchmark",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")
