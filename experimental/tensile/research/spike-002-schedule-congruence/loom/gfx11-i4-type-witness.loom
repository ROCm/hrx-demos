// Prove the gfx11 signed/unsigned packed-I4 WMMA contract independently of
// whether the installed hipBLASLt corpus exposes an I4 GEMM API route.
amdgpu.target<gfx11-generic> @gfx11 {subgroup_size = 32}

kernel.def target(@gfx11) @gfx11_i4_type_witness() {
  %one = index.constant 1 : index
  %wave = index.constant 32 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%wave, %one, %one) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %tile = index.constant 16 : index
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xi32>

  %lhs_schema = encoding.define #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
  %rhs_schema = encoding.define #encoding.operand<element_format=u4, payload_elements=16, payload_registers=2> : encoding<schema>
  %lhs_words = vector.constant -1 : vector<2xi32>
  %rhs_words = vector.constant 572662306 : vector<2xi32>
  %lhs = vector.fragment<lhs> %lhs_words shape [%tile, %tile] using {schema = %lhs_schema : encoding<schema>} : vector<2xi32>
  %rhs = vector.fragment<rhs> %rhs_words shape [%tile, %tile] using {schema = %rhs_schema : encoding<schema>} : vector<2xi32>
  %zero_payload = vector.constant 0 : vector<8xi32>
  %zero = vector.fragment<init> %zero_payload shape [%tile, %tile] : vector<8xi32>
  %result = vector.mma %lhs, %rhs, %zero : vector<2xi32>, vector<2xi32>, vector<8xi32>
  vector.fragment.store<result> %result, %output_view[0, 0] shape [%tile, %tile] : vector<8xi32>, view<16x16xi32>
  kernel.return
}
