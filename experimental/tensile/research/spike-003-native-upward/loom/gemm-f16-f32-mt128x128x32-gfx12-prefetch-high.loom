// A uniform input keeps this case independent of the host's row/column-major
// tensor convention while still exercising every production address. Each
// output is 1024 * (1/32) * (1/32) = 1 exactly.
check.case public @gemm_f16_f32_mt128x128x32_gfx12_scalar_acc_access_case {
  %a = check.generate.fill value(0.03125) : tensor<1024x1024xf16>
  %b = check.generate.fill value(0.03125) : tensor<1024x1024xf16>
  %c = check.generate.fill value(0.0) : tensor<1024x1024xf16>
  %d = check.generate.fill value(0.0) : tensor<1024x1024xf16>
  %expected = check.generate.fill value(1.0) : tensor<1024x1024xf16>
  kernel.launch @gemm_f16_f32_mt128x128x32_gfx12_scalar_acc(%a, %b, %c, %d) : (tensor<1024x1024xf16>, tensor<1024x1024xf16>, tensor<1024x1024xf16>, tensor<1024x1024xf16>)
  check.expect.close actual(%d) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1024x1024xf16>
  check.return
}

check.benchmark<@gemm_f16_f32_mt128x128x32_gfx12_scalar_acc_access_case> @gemm_f16_f32_mt128x128x32_gfx12_scalar_acc_1024

// One complete macro-tile is the access-sanitizer witness. It executes the
// same vectorized global/LDS/fragment address maps as the production case,
// without multiplying sanitizer instrumentation through 32 unrolled K tiles.
