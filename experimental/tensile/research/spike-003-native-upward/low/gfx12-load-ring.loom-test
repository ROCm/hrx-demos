s_mov_b32 s8, 0
  buffer_load_b128 v[172:175], v0, s[0:3], s8 offen offset:0
  buffer_load_b128 v[176:179], v1, s[0:3], s8 offen offset:0
  buffer_load_b128 v[180:183], v2, s[0:3], s8 offen offset:0
  buffer_load_b128 v[184:187], v3, s[0:3], s8 offen offset:0
