// RUN: emit amdgpu-assembly @gfx11_vmem_ring strategy=source

// Reduced schedule witness for the solution-1675 steady-state VMEM ring.
// Five old payloads are consumed into LDS and their physical banks become the
// five next-iteration loads while independent WMMA work remains in flight.
amdgpu.target<gfx11-generic> @target
low.func.def schedule(locked) target<amdgpu.gfx11.generic.core>(@target) @gfx11_vmem_ring(
    %srd_a: reg<amdgpu.sgpr x4>,
    %srd_b: reg<amdgpu.sgpr x4>,
    %offset_a0: reg<amdgpu.vgpr>,
    %offset_a1: reg<amdgpu.vgpr>,
    %offset_b0: reg<amdgpu.vgpr>,
    %offset_b1: reg<amdgpu.vgpr>,
    %offset_b2: reg<amdgpu.vgpr>,
    %lds_a: reg<amdgpu.vgpr>,
    %lds_b: reg<amdgpu.vgpr>,
    %lhs0: reg<amdgpu.vgpr x8>,
    %lhs1: reg<amdgpu.vgpr x8>,
    %rhs0: reg<amdgpu.vgpr x8>,
    %rhs1: reg<amdgpu.vgpr x8>,
    %acc0: reg<amdgpu.vgpr x8>,
    %acc1: reg<amdgpu.vgpr x8>,
    %acc2: reg<amdgpu.vgpr x8>,
    %acc3: reg<amdgpu.vgpr x8>,
    %acc4: reg<amdgpu.vgpr x8>,
    %acc5: reg<amdgpu.vgpr x8>) -> (
      reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>,
      reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>,
      reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>,
      reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>, reg<amdgpu.vgpr x8>) asm {
  %zero = s_mov_b32 0
  %old_a0 = buffer_load_b128 %srd_a, %offset_a0, %zero
  %old_a1 = buffer_load_b128 %srd_a, %offset_a1, %zero
  %old_b0 = buffer_load_b128 %srd_b, %offset_b0, %zero
  %old_b1 = buffer_load_b128 %srd_b, %offset_b1, %zero
  %old_b2 = buffer_load_b128 %srd_b, %offset_b2, %zero

  %next_acc0 = v_wmma_f32_16x16x16_f16 %lhs0, %rhs0, %acc0
  %next_acc1 = v_wmma_f32_16x16x16_f16 %lhs1, %rhs0, %acc1
  %next_acc2 = v_wmma_f32_16x16x16_f16 %lhs0, %rhs1, %acc2

  s_waitcnt {vmcnt = 4, lgkmcnt = 63}
  ds_write_b128 %lds_a, %old_a0
  %next_a0 = buffer_load_b128 %srd_a, %offset_a0, %zero
  s_waitcnt {vmcnt = 4, lgkmcnt = 63}
  ds_write_b128 %lds_a, %old_a1 {offset = 2080}
  %next_a1 = buffer_load_b128 %srd_a, %offset_a1, %zero
  s_waitcnt {vmcnt = 4, lgkmcnt = 63}
  ds_write_b128 %lds_b, %old_b0
  %next_b0 = buffer_load_b128 %srd_b, %offset_b0, %zero
  s_waitcnt {vmcnt = 4, lgkmcnt = 63}
  ds_write_b128 %lds_b, %old_b1 {offset = 2560}
  %next_b1 = buffer_load_b128 %srd_b, %offset_b1, %zero
  s_waitcnt {vmcnt = 4, lgkmcnt = 63}
  ds_write_b128 %lds_b, %old_b2 {offset = 5120}
  %next_b2 = buffer_load_b128 %srd_b, %offset_b2, %zero

  %next_acc3 = v_wmma_f32_16x16x16_f16 %lhs1, %rhs1, %acc3
  %next_acc4 = v_wmma_f32_16x16x16_f16 %lhs0, %rhs0, %acc4
  %next_acc5 = v_wmma_f32_16x16x16_f16 %lhs1, %rhs0, %acc5
  return %next_a0, %next_a1, %next_b0, %next_b1, %next_b2,
         %next_acc0, %next_acc1, %next_acc2, %next_acc3, %next_acc4, %next_acc5
}

// ----
  s_mov_b32 s8, 0
  buffer_load_b128 v[88:91], v24, s[0:3], s8 offen offset:0
  buffer_load_b128 v[92:95], v26, s[0:3], s8 offen offset:0
  buffer_load_b128 v[96:99], v27, s[4:7], s8 offen offset:0
  buffer_load_b128 v[100:103], v28, s[4:7], s8 offen offset:0
  buffer_load_b128 v[104:107], v30, s[4:7], s8 offen offset:0
  v_wmma_f32_16x16x16_f16 v[0:7], v[48:55], v[72:79], v[0:7]
  v_wmma_f32_16x16x16_f16 v[8:15], v[64:71], v[72:79], v[8:15]
  v_wmma_f32_16x16x16_f16 v[16:23], v[48:55], v[32:39], v[16:23]
  s_waitcnt vmcnt(4) lgkmcnt(63)
  ds_write_b128 v25, v[88:91] offset:0
  buffer_load_b128 v[88:91], v24, s[0:3], s8 offen offset:0
  s_waitcnt vmcnt(4) lgkmcnt(63)
  ds_write_b128 v25, v[92:95] offset:2080
  buffer_load_b128 v[92:95], v26, s[0:3], s8 offen offset:0
  s_waitcnt vmcnt(4) lgkmcnt(63)
  ds_write_b128 v29, v[96:99] offset:0
  buffer_load_b128 v[24:27], v27, s[4:7], s8 offen offset:0
  s_waitcnt vmcnt(4) lgkmcnt(63)
  ds_write_b128 v29, v[100:103] offset:2560
  buffer_load_b128 v[96:99], v28, s[4:7], s8 offen offset:0
  s_waitcnt vmcnt(4) lgkmcnt(63)
  ds_write_b128 v29, v[104:107] offset:5120
  buffer_load_b128 v[28:31], v30, s[4:7], s8 offen offset:0
  v_wmma_f32_16x16x16_f16 v[40:47], v[64:71], v[32:39], v[40:47]
  v_wmma_f32_16x16x16_f16 v[56:63], v[48:55], v[72:79], v[56:63]
  v_wmma_f32_16x16x16_f16 v[80:87], v[64:71], v[72:79], v[80:87]
  s_waitcnt vmcnt(0) lgkmcnt(63)
  s_endpgm
