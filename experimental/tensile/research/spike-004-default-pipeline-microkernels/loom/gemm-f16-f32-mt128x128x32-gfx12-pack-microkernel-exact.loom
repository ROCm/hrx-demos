// Candidate record:
// Production boundary: FP16 column-major GEMM, M=N=K=1024, gfx12 family.
// Independent variables retained after separate experiments: name the sixteen
// accumulator SSA values, flatten the four load groups, with a compact
// shape-specialized outer K loop.
// Finding: naming accumulators alone does not remove spill traffic. This variant retains the loop so its prepared Low control flow can be
// used as the starting point for the locked native-style schedule.
// Compiler consequence: 32 WMMA packets per K iteration, zero materialized
// spill storage/reloads, and final VGPR allocation below 256.
// Correctness: independent full-shape reference plus one complete macro-tile
// through Loom's native access sanitizer. Full-shape access instrumentation
// currently fails to compile; see compiler-usability-access-sanitizer.md.
// Stop: do not time unless the compiler consequence appears.
amdgpu.target<gfx1201> @gfx12 {subgroup_size = 32}

amdgpu.target<gfx12-generic> @gfx12_helper {subgroup_size = 32}

low.func.def schedule(locked) target<amdgpu.gfx12.generic.core>(@gfx12_helper) abi(object_function) @pack_lhs_fragments(%raw0: reg<amdgpu.vgpr x2>, %raw1: reg<amdgpu.vgpr x2>, %raw2: reg<amdgpu.vgpr x2>, %raw3: reg<amdgpu.vgpr x2>, %raw4: reg<amdgpu.vgpr x2>, %raw5: reg<amdgpu.vgpr x2>, %raw6: reg<amdgpu.vgpr x2>, %raw7: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) asm {
  %r0l = slice %raw0[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r0h = slice %raw0[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r1l = slice %raw1[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r1h = slice %raw1[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r2l = slice %raw2[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r2h = slice %raw2[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r3l = slice %raw3[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r3h = slice %raw3[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r4l = slice %raw4[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r4h = slice %raw4[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r5l = slice %raw5[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r5h = slice %raw5[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r6l = slice %raw6[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r6h = slice %raw6[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r7l = slice %raw7[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %r7h = slice %raw7[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %even = s_mov_b32 84148480
  %odd = s_mov_b32 117834498
  %f0p0 = v_perm_b32 %r1l, %r0l, %even
  %f0p1 = v_perm_b32 %r3l, %r2l, %even
  %f0p2 = v_perm_b32 %r5l, %r4l, %even
  %f0p3 = v_perm_b32 %r7l, %r6l, %even
  %f0 = concat(%f0p0, %f0p1, %f0p2, %f0p3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %f1p0 = v_perm_b32 %r1l, %r0l, %odd
  %f1p1 = v_perm_b32 %r3l, %r2l, %odd
  %f1p2 = v_perm_b32 %r5l, %r4l, %odd
  %f1p3 = v_perm_b32 %r7l, %r6l, %odd
  %f1 = concat(%f1p0, %f1p1, %f1p2, %f1p3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %f2p0 = v_perm_b32 %r1h, %r0h, %even
  %f2p1 = v_perm_b32 %r3h, %r2h, %even
  %f2p2 = v_perm_b32 %r5h, %r4h, %even
  %f2p3 = v_perm_b32 %r7h, %r6h, %even
  %f2 = concat(%f2p0, %f2p1, %f2p2, %f2p3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %f3p0 = v_perm_b32 %r1h, %r0h, %odd
  %f3p1 = v_perm_b32 %r3h, %r2h, %odd
  %f3p2 = v_perm_b32 %r5h, %r4h, %odd
  %f3p3 = v_perm_b32 %r7h, %r6h, %odd
  %f3 = concat(%f3p0, %f3p1, %f3p2, %f3p3) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %f0, %f1, %f2, %f3
}

